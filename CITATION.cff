cff-version: 1.2.0
message: >-
  If you use these scripts, please cite this repository as below. Most
  scripts build on earlier work; please also cite the sources listed under
  "references" that apply to the script you used (see "How to cite" in
  README.md).
type: software
title: "praat-scripts: Praat scripts for acoustic analysis and speech manipulation"
authors:
  - family-names: Leongómez
    given-names: Juan David
    orcid: "https://orcid.org/0000-0002-0092-6298"
repository-code: "https://github.com/JDLeongomez/praat-scripts"
url: "https://github.com/JDLeongomez/praat-scripts"
keywords:
  - Praat
  - phonetics
  - acoustic analysis
  - speech rate
  - syllable nuclei
  - fundamental frequency
  - formants
  - infant-directed speech
# Scripts carry different licenses (GPL-3.0-or-later, GPL-2.0-or-later,
# CC-BY-NC-SA-4.0); see the "Licenses" section of README.md.
# After the first release, add:
# version: "1.0.0"
# date-released: "2026-MM-DD"
# doi: "10.5281/zenodo.XXXXXXX"
